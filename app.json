{
  "expo": {
    "name": "Kishan Suchna",
    "slug": "KishanSuchna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/image/icon.png",
    "scheme": "kishansuchna",
    "splash": {
      "image": "./src/assets/image/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used to show local weather forecasts.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your location is used to show local weather forecasts.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.deoprakash.KishanSuchna"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/image/splash.png"
      },
      "splash": {
        "image": "./src/assets/image/splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#008000"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.deoprakash.KishanSuchna"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/image/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/image/splash.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./src/assets/image/splash.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a0e80418-79e4-4f97-a725-e41c6a01b4af"
      }
    }
  }
}
